#!/bin/bash
# Functions are dispatched by name through check().
# shellcheck disable=SC2329
set -u

fail=0
check() {
    local label=$1
    shift
    if "$@"; then printf 'PASS %s\n' "$label"; else printf 'FAIL %s\n' "$label"; fail=1; fi
}
is_radxa() { tr -d '\0' </proc/device-tree/model | grep -Eqi 'radxa.*cm5|rk3588s'; }
root_on_nvme() { findmnt -n -o SOURCE / | grep -q '^/dev/nvme'; }
has_nvme() { nvme list 2>/dev/null | grep -q /dev/nvme; }
package_ok() { dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q 'install ok installed'; }
storage_ok() {
    [[ -d /content/packages && -f /etc/shtf-box/storage.env ]] &&
        grep -qx 'SHTF_ROOT=/content' /etc/shtf-box/storage.env
}
shtf_service_ok() {
    package_ok shtf-box &&
        systemctl is-enabled --quiet shtf-box.service &&
        systemctl is-active --quiet shtf-box.service
}
shtf_health_ok() { curl -fsS --max-time 5 http://127.0.0.1:8080/api/v1/health | grep -q '"status":"ok"'; }
systemd_ok() { [[ $(systemctl --failed --no-legend 2>/dev/null | wc -l) -eq 0 ]]; }
boot_points_to_root() {
    local uuid
    uuid=$(findmnt -n -o UUID /)
    grep -Eq "(^|[[:space:]])root=UUID=$uuid([[:space:]]|$)" /boot/extlinux/extlinux.conf
}
panel_backlight_ok() { compgen -G '/sys/class/backlight/*/brightness' >/dev/null; }
panel_dsi_ok() {
    local connector
    connector=$(find /sys/class/drm -maxdepth 1 -type l -name 'card*-DSI-*' | head -n 1)
    [[ -n $connector ]] || return 1
    [[ $(cat "$connector/status") == connected ]] || return 1
    grep -qx '720x1280' "$connector/modes" || return 1
    ! dmesg | grep -Eq 'command interface is busy|panel-cwu50.*failed to (exit sleep mode|turn display on)'
}
rail_high() { pinctrl get "$1" 2>/dev/null | grep -qw hi; }
rtc_ok() { hwclock --show >/dev/null 2>&1; }
wifi_usb_ok() { lsusb | grep -Eqi 'MediaTek|MT7921|0e8d:'; }
wifi_interface_ok() { iw dev 2>/dev/null | grep -q 'Interface'; }
mt7921u_driver_ok() { modinfo mt7921u >/dev/null 2>&1; }
aio2_service_ok() { systemctl is-enabled --quiet aiov2-rails-boot.service; }

check "aarch64" test "$(uname -m)" = aarch64
check "Radxa CM5 model" is_radxa
check "root on NVMe" root_on_nvme
check "NVMe device" has_nvme
check "eMMC boot points to NVMe root" boot_points_to_root
check "panel backlight" panel_backlight_ok
check "panel DSI initialization" panel_dsi_ok
check "MT7921 USB driver" mt7921u_driver_ok
check "HackerGadgets package" package_ok hackergadgets-uconsole-aio-board
check "Meshtastic UI package" package_ok meshtastic-mui
check "SDR package" package_ok sdrpp-brown
check "tar1090 package" package_ok tar1090
check "PyGPSClient package" package_ok pygpsclient
check "AIO2 controller" test -x /usr/local/bin/aiov2_ctl
check "Radxa pinctrl shim" test -x /usr/local/bin/pinctrl
check "AIO2 rail service" aio2_service_ok
check "SDR rail high" rail_high 7
check "internal USB rail high" rail_high 23
check "AC1200 USB device" wifi_usb_ok
check "AC1200 network interface" wifi_interface_ok
check "RTC" rtc_ok
check "SHTF storage" storage_ok
check "SHTF package and service" shtf_service_ok
check "SHTF HTTP health" shtf_health_ok
check "no failed systemd units" systemd_ok
exit "$fail"
